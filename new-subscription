            selectLanguage(currentLang);
            fetchLiveSubscriptionData();
            liveRefreshTimer = setInterval(fetchLiveSubscriptionData, 10000);

        });

        const langToggleBtn = document.getElementById("lang-toggle-btn");
        const langDropdown = document.getElementById("lang-dropdown");
        langToggleBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            langDropdown.classList.toggle("show");
        });

        document.addEventListener("click", () => {
            langDropdown.classList.remove("show");
        });

        // بستن پاپ‌آپ فقط با کلیک روی بک‌دراپ (بیرون کادر) یا دکمه‌ی ضربدر —
        // کلیک روی هر جای داخل لیست دیگه پاپ‌آپ رو نمی‌بنده
        const qrDropdownEl = document.getElementById("dropdown-qr-container");
        const configDropdownEl = document.getElementById("dropdown-config-container");

        qrDropdownEl.addEventListener("click", (e) => {
            if (e.target === qrDropdownEl) qrDropdownEl.classList.remove("show");
        });
        configDropdownEl.addEventListener("click", (e) => {
            if (e.target === configDropdownEl) configDropdownEl.classList.remove("show");
        });
        document.getElementById("close-qr-dropdown").addEventListener("click", (e) => {
            e.stopPropagation();
            qrDropdownEl.classList.remove("show");
        });
        document.getElementById("close-config-dropdown").addEventListener("click", (e) => {
            e.stopPropagation();
            configDropdownEl.classList.remove("show");
        });

        const themeToggle = document.getElementById("theme-toggle");
        const themeIcon = document.getElementById("theme-icon");
        themeToggle.addEventListener("click", () => {
            document.body.classList.toggle("light-mode");
            themeIcon.className = document.body.classList.contains("light-mode") ? "fa-solid fa-sun" : "fa-solid fa-moon";
        });
    </script>
