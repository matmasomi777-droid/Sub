        let pingRunToken = 0;
        async function pingAllConfigs(links) {
            const data = locales[currentLang] || locales.fa;
            const myToken = ++pingRunToken;

            if (!links || links.length === 0) {
                updateBestPingUI(null, data);
                return;
            }

            const bestEl = document.getElementById('best-ping-value');
            if (bestEl) { bestEl.textContent = data.pingChecking; bestEl.className = 'ping-value muted en-font'; }

            const results = await Promise.all(links.map(async (rawLink, idx) => {
                const parsed = parseConfigLink(rawLink);
                const latency = await tcpStylePing(parsed.host, parsed.port);
                if (myToken === pingRunToken) updateConfigPingUI(idx, latency, data);
                return latency;
            }));

            if (myToken !== pingRunToken) return; // یه رندر جدیدتر شروع شده، این نتیجه‌ی قدیمی نادیده گرفته میشه

            const validResults = results.filter(v => v !== null && v !== undefined);
            const best = validResults.length ? Math.min(...validResults) : null;
            updateBestPingUI(best, data);
        }

