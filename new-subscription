        // ===== توابع اصلی =====
        function decodeBase64Unicode(str) {
            const clean = str.replace(/-/g, '+').replace(/_/g, '/').trim();
            const binary = atob(clean);
            const bytes = Uint8Array.from(binary, c => c.charCodeAt(0));
            return new TextDecoder('utf-8').decode(bytes);
        }

        function parseSubscriptionUserinfo(headerValue) {
            const result = { upload: null, download: null, total: null, expire: null };
            if (!headerValue) return result;
            headerValue.split(';').forEach(part => {
                const [key, val] = part.trim().split('=');
                if (key && val !== undefined && result.hasOwnProperty(key.trim())) {
                    result[key.trim()] = parseInt(val.trim(), 10);
                }
            });
            return result;
        }

        async function fetchLiveSubscriptionData() {
            if (!sanaeiClientData.subUrl) return;
            try {
                /* ⚠️ خودِ subUrl صفحه‌ی HTML را برمی‌گرداند — باید فرمت base64 خواسته شود
                   وگرنه بدنه‌ی HTML به‌عنوان «کانفیگ» پارس می‌شد و هیچ کانفیگی نمایش داده نمی‌شد */
                const base = (sanaeiClientData.subUrl || window.location.href).split('#')[0];
                const fetchUrl = base + (base.includes('?') ? '&' : '?') + 'format=base64';
                const response = await fetch(fetchUrl, {
                    method: 'GET',
                    cache: 'no-store',
                    headers: { 'Accept': 'text/plain' }
                });

                if (!response.ok) throw new Error('HTTP ' + response.status);

                const userInfoHeader = response.headers.get('subscription-userinfo');
                const bodyText = (await response.text()).trim();

                if (bodyText) {
                    let decodedLinks = [];
                    try {
                        decodedLinks = decodeBase64Unicode(bodyText).split('\n').map(l => l.trim()).filter(Boolean);
                    } catch (e) {
                        decodedLinks = bodyText.split('\n').map(l => l.trim()).filter(Boolean);
                    }
                    /* فقط ردیف‌های با ساختار واقعیِ کانفیگ — خطای پارس HTML/متن‌های اضافه را حذف می‌کند */
                    decodedLinks = decodedLinks.filter(l => /^(vless|vmess|trojan|ss|ssr|hysteria2?|hy2|tuic|juicity|socks|naive|brook):\/\//i.test(l));
                    if (decodedLinks.length > 0) {
                        sanaeiClientData.links = decodedLinks;
                    }
                }

                if (userInfoHeader) {
                    const info = parseSubscriptionUserinfo(userInfoHeader);
                    if (info.download !== null && info.upload !== null) {
                        sanaeiClientData.downloadByte = info.download;
                        sanaeiClientData.uploadByte = info.upload;
                    }
                    if (info.total !== null) sanaeiClientData.totalByte = info.total;
                    if (info.expire !== null) {
                        sanaeiClientData.expireSeconds = info.expire;
                        sanaeiClientData.daysLeft = calculateDaysLeft(info.expire);
                        const dates = generateExpiryDates(info.expire);
                        sanaeiClientData.expiryDateFa = dates.fa;
                        sanaeiClientData.expiryDateEn = dates.en;
                        sanaeiClientData.expiryDateTr = dates.tr;
                        sanaeiClientData.expiryDateAr = dates.ar;
                    }
                }

                const lastOnlineHeader = response.headers.get('subscription-last-online');
                if (lastOnlineHeader) {
                    const parsed = parseInt(lastOnlineHeader, 10);
                    if (!isNaN(parsed) && parsed > 0) {
                        sanaeiClientData.lastOnline = parsed;
                    }
                }

                updateConnectionStatus();
                renderAll();
            } catch (error) {
                console.error("❌ خطا در دریافت اطلاعات زنده:", error);
            }
        }

        function isUserOnline() {
            const now = Date.now();
            if (sanaeiClientData.lastOnline && sanaeiClientData.lastOnline > 0) {
                const diffSeconds = (now - sanaeiClientData.lastOnline) / 1000;
                return diffSeconds < 300;
            }
            return false;
        }

